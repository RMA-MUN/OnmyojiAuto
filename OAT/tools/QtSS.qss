QDialog {
    background-color: #f0f0f0;
    font-family: "Microsoft YaHei";
}

/* 导航栏样式 */
QWidget#nav_bar {
    background-color: transparent;
    border-bottom: 1px solid #ced4da;
}

/* 导航按钮样式 */
QPushButton#nav_button {
    background-color: #ffffff;
    color: #495057;
    font-size: 13px;
    font-weight: 400;
    border: none;
    border-right: 1px solid #e9ecef;
    padding: 0 20px;
    min-width: 80px;
}

QPushButton#nav_button:hover {
    background-color: #e9ecef;
    color: #212529;
}

QPushButton#nav_button:pressed {
    background-color: #dee2e6;
    color: #212529;
}

/* 移除最后一个按钮的右边框 */
QPushButton#nav_button:last-child {
    border-right: none;
}

QLabel {
    font-size: 14px;
    color: #333;
}

QComboBox {
    font-size: 14px;
    padding: 3px;
    border: 1px solid #ccc;
    border-radius: 3px;
    background-color: #ffffff;
    color: #333333;
}

QSpinBox {
    font-size: 12px;
    padding: 3px;
    border: 1px solid #ccc;
    border-radius: 3px;
    background-color: #ffffff;
    color: #333333;
}

/* 普通按钮样式 */
QPushButton {
    font-size: 12px;
    padding: 6px 16px;
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f5f5f5;
    border-color: #a0a0a0;
    color: #1a73e8;
}

QPushButton:pressed {
    background-color: #e8f0fe;
    border-color: #1557b0;
    color: #1557b0;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #9e9e9e;
    border-color: #e0e0e0;
}

/* 主操作按钮样式（如开始同步等） */
QPushButton#start_sync_btn {
    background-color: #1a73e8;
    color: white;
    border-color: #1a73e8;
}

QPushButton#start_sync_btn:hover {
    background-color: #1557b0;
    border-color: #1557b0;
    color: white;
}

QPushButton#stop_sync_btn {
    background-color: #ea4335;
    color: white;
    border-color: #ea4335;
}

QPushButton#stop_sync_btn:hover {
    background-color: #d93025;
    border-color: #d93025;
    color: white;
}

QPushButton#pushButton4, QPushButton#refresh_windows_btn, QPushButton#arrange_btn,
QPushButton#pushButton, QPushButton#pushButton_2, QPushButton#pushButton_3 {
    background-color: rgba(248, 249, 250, 0.7);
    color: #333333;
    border-color: #d0d0d0;
}

QPushButton#pushButton4:hover, QPushButton#refresh_windows_btn:hover, QPushButton#arrange_btn:hover,
QPushButton#pushButton:hover, QPushButton#pushButton_2:hover, QPushButton#pushButton_3:hover {
    background-color: rgba(232, 234, 237, 0.7);
    border-color: #a0a0a0;
    color: #1a73e8;
}

/* 设置页面样式 */
QWidget#settings_page {
    background-color: rgba(240, 240, 240, 0.85);
}

/* 左侧菜单栏样式 */
QWidget#settings_menu {
    background-color: rgba(255, 255, 255, 0.7);
    border-right: 1px solid rgba(224, 224, 224, 0.8);
}

/* 设置页面菜单项样式 */
QPushButton#settings_menu_item {
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
    border: none;
    border-right: 3px solid transparent;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 16px;
    text-align: left;
}

QPushButton#settings_menu_item:hover {
    background-color: rgba(245, 245, 245, 0.7);
    color: #1a73e8;
}

QPushButton#settings_menu_item:checked {
    background-color: rgba(232, 240, 254, 0.7);
    color: #1a73e8;
    border-right-color: #1a73e8;
}

/* 右侧内容区域样式 */
QStackedWidget#settings_content {
    background-color: rgba(255, 255, 255, 0.7);
}

/* 设置页面表单元素样式 */
QGroupBox {
    font-size: 14px;
    font-weight: 600;
    color: #333333;
    border: 1px solid rgba(224, 224, 224, 0.8);
    border-radius: 4px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.7);
}

QGroupBox::title {
    color: #000000;
    left: 8px;
    top: -6px;
    padding: 0 4px;
}

QFormLayout QLabel {
    font-weight: 500;
    color: #555555;
    min-width: 100px;
}

QComboBox#settings_combo {
    padding: 6px 12px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
    margin-top: 10px;
}

QComboBox#settings_combo:hover {
    border-color: #a0a0a0;
}

QComboBox {
    font-size: 14px;
    padding: 3px;
    border: 1px solid #ccc;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
}

QSpinBox#settings_spin {
    padding: 6px 12px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
    width: 100px;
}

QSpinBox#settings_spin:hover {
    border-color: #a0a0a0;
}

QSpinBox {
    font-size: 12px;
    padding: 3px;
    border: 1px solid #ccc;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
}

QCheckBox#settings_checkbox {
    font-size: 12px;
    color: #333333;
    spacing: 10px;
    margin-top: 5px;
    background-color: transparent;
}

QCheckBox {
    font-size: 12px;
    color: #333333;
    spacing: 10px;
    background-color: transparent;
}

/* 关于页面样式 */
QLabel#about_title {
    font-size: 20px;
    font-weight: 600;
    color: #2F4F4F;
    margin-bottom: 10px;
}

QLabel#about_text {
    font-size: 14px;
    color: #555555;
    margin-bottom: 10px;
}

QLabel#about_link {
    font-size: 14px;
    color: #2F4F4F;
    margin-top: 10px;
}

QLabel#about_link:hover {
    color: #1557b0;
}

QTextBrowser {
    font-size: 14px;
    border: 1px solid rgba(204, 204, 204, 0.7);
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
}

QTextBrowser QScrollBar {
    background: transparent;
}

QTextBrowser::viewport {
    background-color: rgba(255, 255, 255, 0.7);
}

QTextBrowser QScrollBar:vertical {
    width: 10px;
    background: rgba(240, 240, 240, 0.7);
}

QTextBrowser QScrollBar::handle:vertical {
    background: rgba(192, 192, 192, 0.7);
    border-radius: 5px;
}

QTextBrowser QScrollBar::add-line:vertical, QTextBrowser QScrollBar::sub-line:vertical {
    background: none;
}

QPushButton#clearButton, QPushButton#selctButton, QPushButton#startButton {
    background-color: rgba(245, 245, 232, 0.7);
    color: black;
    border: none;
    text-align: left;
}

/* 功能区域样式 */
QWidget#system {
    background-color: transparent;
}

QWidget#soul_land_options {
    background-color: transparent;
}

/* 表格样式 */
QTableWidget {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(204, 204, 204, 0.7);
}

QTableWidget::item {
    background-color: transparent;
}

/* 选中的表格单元格 */
QTableWidget::item:selected {
    background-color: #2196F3;
    color: white;
}

/* 选中但失去焦点的表格单元格 */
QTableWidget::item:selected:!active {
    background-color: #1976D2;
    color: white;
}

QTableWidget QHeaderView::section {
    background-color: rgba(240, 240, 240, 0.7);
    border: 1px solid rgba(204, 204, 204, 0.7);
}

/* 工具提示样式 */
QToolTip {
    background-color: rgba(255, 255, 255, 0.9);
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}